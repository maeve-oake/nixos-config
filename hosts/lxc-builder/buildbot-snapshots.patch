+class SnapshotSkippedBuilds(buildstep.ShellMixin, steps.BuildStep):
+    """Run dix against out paths skipped because they were already local."""
+
+    def __init__(self, project: GitProject, **kwargs: Any) -> None:
+        kwargs = self.setupShellMixin(kwargs)
+        super().__init__(**kwargs)
+        self.project = project
 
+    async def run(self) -> int:
+        if self.build is None:
+            return util.SKIPPED
+        props = self.build.getProperties()
+        revision = props.getProperty("got_revision")
+        if not revision:
+            return util.SKIPPED
 
+        skipped: list[tuple[str, str]] = []
+        for prop_name, (value, _source) in props.properties.items():
+            if prop_name.endswith("-skipped_out_path") and value:
+                attr = prop_name[: -len("-skipped_out_path")]
+                skipped.append((attr, value))
+
+        if not skipped:
+            return util.SKIPPED
+
+        failed = False
+        for attr, out_path in skipped:
+            cmd = await self.makeRemoteShellCommand(
+                command=[
+                    "save-build-snapshots",
+                    self.project.name,
+                    revision,
+                    attr,
+                    out_path,
+                ],
+                logEnviron=False,
+            )
+            await self.runCommand(cmd)
+            if cmd.didFail():
+                failed = True
+
+        return util.WARNINGS if failed else util.SUCCESS
+
