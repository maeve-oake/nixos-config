diff --git a/nixbot/lifecycle.py b/nixbot/lifecycle.py
new file mode 100644
index 0000000..5ae43b7
--- /dev/null
+++ b/nixbot/lifecycle.py
@@ -0,0 +1,246 @@
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+from datetime import datetime, timezone
+
+from .config import PostBuildStep
+from .models import NixEvalJobSuccess
+from .post_build import run_post_build_step
+
+
+def identity(o, event, build):
+    return dict(
+        repository=event.repo.name,
+        forge=event.repo.forge,
+        tree_hash=build.tree_hash,
+        base_revision=event.base_sha,
+        revision=event.commit_sha,
+        branch=event.branch,
+        default_branch=event.repo.default_branch,
+        build_id=build.id_,
+        build_number=build.number,
+        generation=build.status_generation,
+        pr_number=event.pr_number,
+        url=f"{o.config.url}/repos/{event.repo.forge}/{event.repo.name}/builds/{build.number}",
+    )
+
+
+async def enqueue(o, event, build, kind, payload, attr=""):
+    payload = {
+        "schema_version": 1,
+        "kind": kind,
+        **identity(o, event, build),
+        **payload,
+    }
+    return await enqueue_payload(o, build, kind, payload, attr)
+
+
+async def enqueue_payload(o, build, kind, payload, attr=""):
+    steps = [
+        step
+        for step in getattr(o.config, kind)
+        if not step.repositories or payload.get("repository") in step.repositories
+    ]
+    if not steps:
+        return None
+    async with o.pool.acquire() as conn, conn.transaction():
+        await conn.execute("SELECT pg_advisory_xact_lock($1)", build.id_)
+        old = await conn.fetchrow(
+            """SELECT * FROM lifecycle_deliveries WHERE build_id=$1
+            AND attr=$2 AND kind=$3 ORDER BY version DESC LIMIT 1""",
+            build.id_,
+            attr,
+            kind,
+        )
+        encoded = json.dumps(
+            dict(
+                context=payload,
+                steps=[s.model_dump(mode="json", by_alias=True) for s in steps],
+            ),
+            sort_keys=True,
+        )
+        if old:
+            previous = json.loads(old["payload"])
+            previous["context"].pop("observed_at", None)
+            if previous == json.loads(encoded):
+                return old["id"]
+        payload["observed_at"] = datetime.now(timezone.utc).isoformat()
+        encoded = json.dumps(
+            dict(
+                context=payload,
+                steps=[s.model_dump(mode="json", by_alias=True) for s in steps],
+            ),
+            sort_keys=True,
+        )
+        return await conn.fetchval(
+            """INSERT INTO lifecycle_deliveries(build_id,attr,kind,version,payload)
+            VALUES($1,$2,$3,$4,$5) RETURNING id""",
+            build.id_,
+            attr,
+            kind,
+            old["version"] + 1 if old else 1,
+            encoded,
+        )
+
+
+async def deliver(pool, row, cwd):
+    payload = json.loads(row["payload"])
+    await pool.execute(
+        "UPDATE lifecycle_deliveries SET state='running',attempts=attempts+1,updated_at=now() WHERE id=$1",
+        row["id"],
+    )
+    results = []
+    try:
+        for config in payload["steps"]:
+            result = await run_post_build_step(
+                PostBuildStep.model_validate(config),
+                {},
+                cwd,
+                context=payload["context"],
+            )
+            results.append(result)
+        failed = any(r.failed for r in results)
+        output = "\n".join(f"{r.name}: {r.output}" for r in results)
+    except asyncio.CancelledError:
+        await pool.execute(
+            "UPDATE lifecycle_deliveries SET state='queued' WHERE id=$1", row["id"]
+        )
+        raise
+    except Exception as exc:
+        failed, output = True, str(exc)
+    await pool.execute(
+        """UPDATE lifecycle_deliveries SET state=$2,error=$3,output=$4,updated_at=now()
+        WHERE id=$1""",
+        row["id"],
+        "failed" if failed else "complete",
+        output if failed else "",
+        output,
+    )
+    return not failed, output
+
+
+async def run_async_hooks(o, kind):
+    while True:
+        try:
+            rows = await o.pool.fetch(
+                """SELECT * FROM lifecycle_deliveries WHERE (kind=$1 OR
+                ($1='evaluation_finished' AND kind='attribute_finished'
+                 AND payload->'context'->>'outcome'='cancelled')) AND (state IN ('queued','running') OR (state='failed' AND updated_at<now()-interval '5 seconds')) ORDER BY id""",
+                kind,
+            )
+            for row in rows:
+                await deliver(o.pool, row, o.config.state_dir)
+        except Exception:
+            logging.getLogger(__name__).exception(
+                "asynchronous hook delivery interrupted"
+            )
+        await asyncio.sleep(0.5)
+
+
+async def evaluation(o, event, build, jobs, *, complete=True, error=None):
+    data = dict(
+        attributes=[j.model_dump(mode="json") for j in jobs],
+        finished=True,
+        generation=build.status_generation,
+        source=identity(o, event, build),
+        inventory_complete=complete
+        and not error
+        and all(isinstance(j, NixEvalJobSuccess) for j in jobs),
+        errors=[
+            dict(attr=j.attr, error=j.error)
+            for j in jobs
+            if not isinstance(j, NixEvalJobSuccess)
+        ],
+        error=error,
+    )
+    await enqueue(o, event, build, "evaluation_finished", data)
+    await o.pool.execute(
+        """INSERT INTO evaluation_contexts VALUES($1,$2) ON CONFLICT(build_id)
+        DO UPDATE SET payload=excluded.payload""",
+        build.id_,
+        json.dumps(data),
+    )
+
+
+async def attribute(
+    o, event, build, job, outcome, cwd, writer=None, *, compilation_outcome=None
+):
+    if not o.config.attribute_finished:
+        return True
+    while True:
+        context = await o.pool.fetchval(
+            "SELECT payload FROM evaluation_contexts WHERE build_id=$1", build.id_
+        )
+        if outcome == "cancelled":
+            context = context or json.dumps({"attributes": [], "finished": False})
+            break
+        if context and json.loads(context).get("finished", True):
+            break
+        await asyncio.sleep(0.2)
+    evaluation = json.loads(context)
+    source = evaluation.get("source", {})
+    source["generation"] = evaluation.get("generation", build.status_generation)
+    row_id = await enqueue(
+        o,
+        event,
+        build,
+        "attribute_finished",
+        dict(
+            attribute=job.model_dump(mode="json"),
+            outcome=outcome,
+            compilation_outcome=compilation_outcome or outcome,
+            evaluation=evaluation,
+            **source,
+        ),
+        job.attr,
+    )
+    if row_id is None:
+        return True
+    if outcome == "cancelled":
+        await o.pool.execute(
+            """UPDATE lifecycle_deliveries SET state='cancelled' WHERE build_id=$1
+            AND attr=$2 AND kind='attribute_finished' AND id<>$3
+            AND state IN ('queued','failed')""",
+            build.id_,
+            job.attr,
+            row_id,
+        )
+        return True
+    row = await o.pool.fetchrow(
+        "SELECT * FROM lifecycle_deliveries WHERE id=$1", row_id
+    )
+    if row["state"] == "complete":
+        return True
+    while True:
+        preceding = await o.pool.fetchrow(
+            """SELECT state,error FROM lifecycle_deliveries WHERE build_id=$1
+            AND kind='evaluation_finished' ORDER BY version DESC LIMIT 1""",
+            build.id_,
+        )
+        if preceding is None or preceding["state"] == "complete":
+            break
+        if preceding["state"] == "failed":
+            if outcome not in ("success", "succeeded", "skipped_local"):
+                break
+            error = "evaluation_finished handler failed: " + preceding["error"]
+            await o.pool.execute(
+                """UPDATE lifecycle_deliveries SET state='failed',error=$2,output=$2,
+                updated_at=now() WHERE id=$1""",
+                row_id,
+                error,
+            )
+            if writer:
+                await writer.write((error + "\n").encode())
+            return False
+        await asyncio.sleep(0.2)
+    ok, output = False, ""
+    for _ in range(3):
+        ok, output = await deliver(o.pool, row, cwd)
+        if writer:
+            await writer.write(("\nattribute_finished: " + output + "\n").encode())
+        if ok:
+            break
+        await asyncio.sleep(2)
+    return ok
