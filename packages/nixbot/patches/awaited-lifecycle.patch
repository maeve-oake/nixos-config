diff --git a/nixbot/completion.py b/nixbot/completion.py
new file mode 100644
index 0000000..d9e3b54
--- /dev/null
+++ b/nixbot/completion.py
@@ -0,0 +1,195 @@
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import dataclasses
+import json
+import logging
+import tempfile
+import uuid
+from pathlib import Path
+
+from . import lifecycle
+from .db_gen import builds as builds_q
+from .models import NixEvalJobSuccess
+from .post_build import build_props, run_post_build_steps
+from .repo_config import BranchConfig
+from .upload import UploadResult
+
+logger = logging.getLogger(__name__)
+
+
+async def complete_attribute(o, event, build, job, outcome, cwd, writer):
+    compilation_outcome = outcome
+
+    async def publish():
+        paths = (
+            []
+            if job.build_dependencies_only
+            else [p for p in job.outputs.values() if p]
+        )
+        if (
+            any(p is None for p in job.outputs.values())
+            and not job.build_dependencies_only
+        ):
+            from .upload import _run
+
+            rc, out = await _run(
+                ["nix", "build", "--no-link", "--json", job.drv_path + "^*"],
+                merge_stderr=False,
+            )
+            if rc:
+                return "post_build_failure"
+            job.outputs = json.loads(out)[0]["outputs"]
+            paths = list(job.outputs.values())
+        raw_results = await asyncio.gather(
+            *(u.upload(paths, owner=(build.id_, job.attr)) for u in o.uploaders),
+            return_exceptions=True,
+        )
+        results = [
+            r if isinstance(r, UploadResult) else UploadResult(False, str(r))
+            for r in raw_results
+        ]
+        for uploader, result in zip(o.uploaders, results, strict=True):
+            await writer.write(
+                f"\nupload {uploader.name}: "
+                f"{'ok' if result.success else 'failed'}\n".encode()
+            )
+            await writer.write(result.output.encode())
+        if any(not result.success for result in results):
+            return "post_build_failure"
+        step_results = await run_post_build_steps(
+            o.config.post_build_steps if outcome == "success" else [],
+            build_props(event, job),
+            cwd,
+        )
+        for step in step_results:
+            await writer.write(
+                f"\npost-build step {step.name}: "
+                f"{'ok' if step.success else 'failed'}\n".encode()
+            )
+            await writer.write(step.output.encode())
+        if any(step.failed for step in step_results):
+            # The derivation built: fail the attribute without
+            # poisoning the failed-build cache.
+            return "post_build_failure"
+        return outcome
+
+    async def finish():
+        result = await publish() if outcome in ("success", "skipped_local") else outcome
+        ok = await lifecycle.attribute(
+            o,
+            event,
+            build,
+            job,
+            result,
+            cwd,
+            writer,
+            compilation_outcome=compilation_outcome,
+        )
+        return (
+            "post_build_failure"
+            if not ok and result in ("success", "skipped_local")
+            else result
+        )
+
+    key = (build.id_, job.attr)
+    own_cancel = key not in o.attr_cancel_events
+    cancel = o.attr_cancel_events.setdefault(key, asyncio.Event())
+    mirror = (
+        asyncio.create_task(_mirror_cancel(o, build.id_, cancel))
+        if own_cancel
+        else None
+    )
+    task = asyncio.create_task(finish())
+    cancelled = asyncio.create_task(cancel.wait())
+    try:
+        done, _ = await asyncio.wait(
+            {task, cancelled}, return_when=asyncio.FIRST_COMPLETED
+        )
+        if task in done:
+            return await task
+        task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
+        await lifecycle.attribute(
+            o,
+            event,
+            build,
+            job,
+            "cancelled",
+            cwd,
+            writer,
+            compilation_outcome=compilation_outcome,
+        )
+        return "cancelled"
+    finally:
+        cancelled.cancel()
+        task.cancel()
+        await asyncio.gather(task, cancelled, return_exceptions=True)
+        if mirror:
+            mirror.cancel()
+            await asyncio.gather(mirror, return_exceptions=True)
+            o.attr_cancel_events.pop(key, None)
+
+
+async def _mirror_cancel(o, build_id, cancel):
+    await o.cancel_events.setdefault(build_id, asyncio.Event()).wait()
+    cancel.set()
+
+
+async def evaluate_metadata(o, event, build, cwd, credentials=None):
+    from .build_run import _eval_settings, _with_build_store
+
+    async with o.eval_slots, contextlib.AsyncExitStack() as stack:
+        with tempfile.TemporaryDirectory(
+            prefix="metadata-", dir=o.config.state_dir
+        ) as directory:
+            settings = dataclasses.replace(
+                _eval_settings(o, event, build, credentials),
+                gc_roots_dir=Path(directory),
+            )
+            settings = await _with_build_store(o, event, build, settings, stack)
+            return await o.eval_runner.run(cwd, BranchConfig.load(cwd), settings)
+
+
+async def report_reused_inventory(o, event, build):
+    if not o.config.evaluation_finished or event.commit_sha == build.commit_sha:
+        return
+    worktree = None
+    try:
+        worktree = await o.repos.checkout_for_build(
+            event.repo.key,
+            "inventory-" + uuid.uuid4().hex,
+            base_commit=event.commit_sha,
+        )
+        evaluated = await evaluate_metadata(o, event, build, worktree.path)
+        stored = {
+            row.attr: row
+            for row in await builds_q.eval_job_rows(o.pool, build_id=build.id_)
+        }
+        for job in evaluated.jobs:
+            if (
+                isinstance(job, NixEvalJobSuccess)
+                and job.system in o.config.build_systems
+            ):
+                previous = stored.get(job.attr)
+                if (
+                    previous is None
+                    or previous.drv_path != job.drv_path
+                    or (json.loads(previous.outputs) if previous.outputs else {})
+                    != job.outputs
+                ):
+                    raise ValueError(
+                        "Reused revision evaluates to different outputs; inventory was not reported"
+                    )
+        await lifecycle.evaluation(o, event, build, evaluated.jobs)
+    except Exception:
+        logger.exception(
+            "reused revision inventory failed", extra={"build_id": build.id_}
+        )
+    finally:
+        if worktree is not None:
+            try:
+                await o.repos.remove_worktree(worktree)
+            except Exception:
+                logger.exception("inventory worktree cleanup failed")
