new file mode 100644
index 0000000..06611b7
--- /dev/null
+++ b/nixbot/lifecycle.py
@@ -0,0 +1,130 @@
+from __future__ import annotations
+
+import logging
+from datetime import datetime, timezone
+
+from .gitrepo import run_git
+from .models import NixEvalJobSuccess
+from .post_build import run_post_build_step
+
+
+def identity(o, event, build):
+    return dict(
+        repository=event.repo.name,
+        forge=event.repo.forge,
+        revision=event.commit_sha,
+        branch=event.branch,
+        build_id=build.id_,
+        build_number=build.number,
+        generation=build.status_generation,
+        pr_number=event.pr_number,
+        url=f"{o.config.url}/repos/{event.repo.forge}/{event.repo.name}/builds/{build.number}",
+    )
+
+
+async def run(o, kind, payload, cwd, writer=None):
+    ok = True
+    for step in getattr(o.config, kind):
+        if step.repositories and payload["repository"] not in step.repositories:
+            continue
+        try:
+            result = await run_post_build_step(step, {}, cwd, context=payload)
+            if writer:
+                await writer.write(
+                    ("\n" + step.name + ": " + result.output + "\n").encode()
+                )
+            if result.failed:
+                logging.getLogger(__name__).error(
+                    "%s failed: %s", step.name, result.output
+                )
+                ok = False
+        except Exception:
+            logging.getLogger(__name__).exception("%s failed", step.name)
+            ok = False
+    return ok
+
+
+async def evaluation(o, event, build, jobs, *, complete=True, error=None):
+    if not o.config.evaluation_finished:
+        return
+    await run(
+        o,
+        "evaluation_finished",
+        dict(
+            kind="evaluation_finished",
+            **identity(o, event, build),
+            observed_at=datetime.now(timezone.utc).isoformat(),
+            attributes=[j.model_dump(mode="json") for j in jobs],
+            inventory_complete=complete
+            and not error
+            and all(isinstance(j, NixEvalJobSuccess) for j in jobs),
+            errors=[
+                dict(attr=j.attr, error=j.error)
+                for j in jobs
+                if not isinstance(j, NixEvalJobSuccess)
+            ],
+            error=error,
+        ),
+        o.config.state_dir,
+    )
+
+
+async def attribute(
+    o, event, build, job, outcome, cwd, writer=None, *, compilation_outcome=None
+):
+    if not o.config.attribute_finished:
+        return True
+    return await run(
+        o,
+        "attribute_finished",
+        dict(
+            kind="attribute_finished",
+            **identity(o, event, build),
+            observed_at=datetime.now(timezone.utc).isoformat(),
+            attribute=job.model_dump(mode="json"),
+            outcome=outcome,
+            compilation_outcome=compilation_outcome or outcome,
+        ),
+        cwd,
+        writer,
+    )
+
+
+async def finished(o, event, build, status, failures=(), *, evaluation_error=None):
+    if not any(
+        not step.repositories or event.repo.name in step.repositories
+        for step in o.config.build_finished
+    ):
+        return
+    try:
+        author = (
+            await run_git(
