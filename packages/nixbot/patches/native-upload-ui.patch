diff --git a/nixbot/web/uploads.py b/nixbot/web/uploads.py
new file mode 100644
index 0000000..9ad49b0
--- /dev/null
+++ b/nixbot/web/uploads.py
@@ -0,0 +1,88 @@
+from __future__ import annotations
+
+from fastapi import APIRouter, Request
+from fastapi.responses import HTMLResponse
+
+
+async def overview(ctx, request, build_id=None, attr=None):
+    if not ctx.uploaders:
+        return dict(destinations=[])
+    visible = await ctx.visible_repo_ids(request)
+    rows = await ctx.pool.fetch(
+        """SELECT DISTINCT p.* FROM nixbot_uploads.publication_paths p
+        LEFT JOIN nixbot_uploads.publication_members m USING(destination,path)
+        LEFT JOIN nixbot_uploads.publications s ON s.id=m.publication_id
+        LEFT JOIN builds b ON b.id=s.build_id
+        WHERE ($1::bigint IS NULL OR s.build_id=$1) AND ($2::text IS NULL OR s.attr=$2)
+        AND ($1::bigint IS NOT NULL OR p.state IN ('queued','uploading','retrying') OR (p.state='failed' AND EXISTS(SELECT 1 FROM build_attributes a WHERE a.build_id=s.build_id AND a.attr=s.attr AND a.status IN ('pending','building'))))
+        AND ($3::bigint[] IS NULL OR b.project_id=ANY($3)) ORDER BY p.destination,p.path""",
+        build_id,
+        attr,
+        visible,
+    )
+    uploaders = {u.destination: u for u in ctx.uploaders if hasattr(u, "destination")}
+    destinations = {
+        key: dict(name=u.name, paths=[]) for key, u in sorted(uploaders.items())
+    }
+    for row in rows:
+        key = row["destination"]
+        if key in destinations:
+            destinations[key]["paths"].append(dict(row))
+    members = await ctx.pool.fetch(
+        """SELECT m.destination,m.path,count(*) AS subscribers
+        FROM nixbot_uploads.publication_members m JOIN nixbot_uploads.publications s ON s.id=m.publication_id
+        JOIN builds b ON b.id=s.build_id
+        WHERE s.state IN ('planning','waiting') AND ($1::bigint[] IS NULL OR b.project_id=ANY($1)) GROUP BY m.destination,m.path""",
+        visible,
+    )
+    shared = {(r["destination"], r["path"]): r["subscribers"] for r in members}
+    for key, section in destinations.items():
+        paths = section["paths"]
+        order = {"uploading": 0, "failed": 1, "retrying": 2, "queued": 3}
+        pending = sorted(
+            (p for p in paths if p["state"] in order),
+            key=lambda p: (order[p["state"]], p["path"]),
+        )
+        limit = 5
+        section["visible_paths"] = pending[:limit]
+        section["hidden_paths"] = max(0, len(pending) - limit)
+        for path in section["visible_paths"]:
+            path["name"] = path["path"].rsplit("/", 1)[-1].split("-", 1)[-1]
+            path["sent"] = min(
+                path["bytes"], uploaders[key].progress.get(path["path"], 0)
+            )
+            path["percent"] = (
+                min(100, int(100 * path["sent"] / path["bytes"]))
+                if path["bytes"]
+                else 0
+            )
+            size = path["bytes"]
+            path["size_label"] = (
+                f"{size / 1024**3:.2f} GiB"
+                if size >= 1024**3
+                else (
+                    f"{round(size / 1024**2)} MiB"
+                    if size >= 1024**2
+                    else f"{max(1, round(size / 1024))} KiB"
+                )
+            )
+            path["shared"] = shared.get((key, path["path"]), 0)
+    return dict(
+        destinations=list(destinations.values()),
+    )
+
+
+def create_upload_router(ctx):
+    router = APIRouter(include_in_schema=False)
+
+    @router.get("/uploads", response_class=HTMLResponse)
+    async def panel(
+        request: Request, build_id: int | None = None, attr: str | None = None
+    ):
+        return await ctx.render(
+            "_uploads.html",
+            request=request,
+            **await overview(ctx, request, build_id, attr),
+        )
+
+    return router
