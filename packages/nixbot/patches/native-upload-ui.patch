diff --git a/nixbot/web/static/uploads.js b/nixbot/web/static/uploads.js
new file mode 100644
index 0000000..f2dcc93
--- /dev/null
+++ b/nixbot/web/static/uploads.js
@@ -0,0 +1,27 @@
+class NixbotUploadPath extends HTMLElement {
+  connectedCallback() {
+    this.addEventListener("click", this.copy);
+    this.addEventListener("keydown", this.copy);
+  }
+
+  disconnectedCallback() {
+    this.removeEventListener("click", this.copy);
+    this.removeEventListener("keydown", this.copy);
+  }
+
+  async copy(event) {
+    const name = event.target.closest(".upload-name");
+    if (!name || (event.type === "keydown" && !["Enter", " "].includes(event.key))) return;
+    event.preventDefault();
+    try {
+      await navigator.clipboard.writeText(name.dataset.path);
+      name.title = "Copied";
+      setTimeout(() => { name.title = `Copy ${name.dataset.path}`; }, 1500);
+    } catch {
+      name.title = "Unable to copy path";
+    }
+  }
+
+}
+
+customElements.define("nixbot-upload-path", NixbotUploadPath);
