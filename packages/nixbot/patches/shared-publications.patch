index 0000000..257cee3
--- /dev/null
+++ b/nixbot/publication.py
@@ -0,0 +1,403 @@
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import hashlib
+import json
+import logging
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from .upload import PATH_INFO_CMD, Uploader, UploadResult, _run, chunk_args
+
+
+@dataclass
+class PublicationUploader(Uploader):
+    root_dir: Path = field(kw_only=True)
+
+    def __post_init__(self):
+        self._lock = asyncio.Lock()
+        self.progress = {}
+        self._root = self.root_dir
+        self._root.mkdir(parents=True, exist_ok=True)
+        self.destination = self.name
+        self.active_destinations = [self.destination]
+
+    async def _closure(self, paths, *, recursive=True):
+        found = {}
+        for chunk in chunk_args(sorted(set(paths))):
+            rc, out = await _run(
+                [*PATH_INFO_CMD, *(["--recursive"] if recursive else []), *chunk],
+                merge_stderr=False,
+            )
+            if rc:
+                raise RuntimeError("Unable to resolve required closure: " + out[-4000:])
+            data = json.loads(out)
+            if isinstance(data, list):
+                data = {item["path"]: item for item in data}
+            if any(info is None for info in data.values()):
+                raise RuntimeError("Required store path is missing")
+            found.update(
+                {path: int(info.get("narSize", 0)) for path, info in data.items()}
+            )
+        return found
+
+    def _pin_name(self, path, destination=None):
+        return (
+            self._root
+            / hashlib.sha256(
+                ((destination or self.destination) + path).encode()
+            ).hexdigest()
+        )
+
+    async def _pin(self, path):
+        root = self._pin_name(path)
+        if root.exists():
+            return False
+        rc, out = await _run(
+            ["nix-store", "--add-root", str(root), "--indirect", "--realise", path]
+        )
+        if rc:
+            raise RuntimeError("Unable to pin publication: " + out[-2000:])
+        return True
+
+    async def _enqueue(self, paths, owner=None, *, recursive=True):
+        closure = await self._closure(paths, recursive=recursive)
+        if self.config.plan_command is not None:
+            missing = set()
+            _, env = self._command()
+            for chunk in chunk_args(sorted(closure)):
+                stdin = (
+                    ("\n".join(chunk) + "\n").encode()
+                    if self.config.paths_via == "stdin"
+                    else None
+                )
+                rc, out = await _run(
+                    self.config.plan_command
+                    if stdin
+                    else [*self.config.plan_command, *chunk],
+                    stdin=stdin,
+                    env=env,
+                    timeout=self.timeout,
+                    merge_stderr=False,
+                )
+                if rc:
+                    raise RuntimeError("Unable to plan cache upload: " + out[-4000:])
+                missing.update(item["path"] for item in json.loads(out)["paths"])
+            if not missing <= closure.keys():
+                raise RuntimeError(
+                    "Upload plan contains paths outside the requested closure"
+                )
+            closure = {path: size for path, size in closure.items() if path in missing}
+        roots = set(closure) if self.config.plan_command is not None else set(paths)
+        created = []
+        async with self._lock:
+            try:
+                async with self.pool.acquire() as conn, conn.transaction():
+                    publication = None
+                    if owner:
+                        publication = await conn.fetchval(
+                            """INSERT INTO nixbot_uploads.publications(build_id,attr,destination) VALUES($1,$2,$3)
+                            ON CONFLICT(build_id,attr,destination) DO UPDATE SET state='planning',error=''
+                            RETURNING id""",
+                            *owner,
+                            self.destination,
+                        )
+                        await conn.execute(
+                            "DELETE FROM nixbot_uploads.publication_members WHERE publication_id=$1",
+                            publication,
+                        )
+                    for path in sorted(roots):
+                        if await self._pin(path):
+                            created.append(path)
+                    await conn.executemany(
+                        """INSERT INTO nixbot_uploads.publication_paths(destination,path,bytes,pinned) VALUES($1,$2,$3,$5)
+                        ON CONFLICT(destination,path) DO UPDATE SET
+                          pinned=nixbot_uploads.publication_paths.pinned OR excluded.pinned,
+                          state=CASE WHEN nixbot_uploads.publication_paths.state IN ('uploading','queued','retrying')
+                            OR (nixbot_uploads.publication_paths.state='complete' AND nixbot_uploads.publication_paths.updated_at > now()-$4::double precision*interval '1 second')
+                            THEN nixbot_uploads.publication_paths.state ELSE 'queued' END,
+                          attempts=CASE WHEN nixbot_uploads.publication_paths.state IN ('uploading','queued','retrying')
+                            THEN nixbot_uploads.publication_paths.attempts ELSE 0 END,
+                          available_at=CASE WHEN nixbot_uploads.publication_paths.state IN ('queued','retrying','uploading') THEN nixbot_uploads.publication_paths.available_at ELSE now() END""",
+                        [
+                            (
+                                self.destination,
+                                path,
+                                size,
+                                0.0
+                                if self.config.plan_command is not None
+                                else float(self.config.success_ttl),
+                                path in roots,
+                            )
+                            for path, size in closure.items()
+                        ],
+                    )
+                    if publication:
+                        await conn.executemany(
+                            "INSERT INTO nixbot_uploads.publication_members VALUES($1,$2,$3) ON CONFLICT DO NOTHING",
+                            [(publication, self.destination, path) for path in closure],
+                        )
+                    if publication:
+                        await conn.execute(
+                            "UPDATE nixbot_uploads.publications SET state='waiting' WHERE id=$1",
+                            publication,
+                        )
+            except BaseException:
+                for path in created:
+                    try:
+                        tracked = await self.pool.fetchval(
+                            "SELECT pinned FROM nixbot_uploads.publication_paths WHERE destination=$1 AND path=$2",
+                            self.destination,
+                            path,
+                        )
+                    except Exception:
+                        continue
+                    if not tracked:
+                        self._pin_name(path).unlink(missing_ok=True)
+                raise
+        self._wake.set()
+        return publication
+
+    async def reconcile_roots(self):
+        rows = await self.pool.fetch(
+            "SELECT destination,path FROM nixbot_uploads.publication_paths WHERE pinned"
+        )
+        expected = {
+            self._pin_name(row["path"], row["destination"]).name for row in rows
+        }
+        for root in self._root.iterdir():
+            if root.is_symlink() and root.name not in expected:
+                root.unlink(missing_ok=True)
+
+    async def _cleanup_pins(self):
+        async with self._lock:
+            rows = await self.pool.fetch(
+                """SELECT p.destination,p.path FROM nixbot_uploads.publication_paths p WHERE p.pinned
+                AND ((p.destination=$1 AND p.state IN ('complete','failed'))
+                     OR NOT p.destination=ANY($2::text[]))
+                AND NOT EXISTS (
+                  SELECT 1 FROM nixbot_uploads.publication_members m JOIN nixbot_uploads.publications s ON s.id=m.publication_id
+                  WHERE m.destination=p.destination AND m.path=p.path AND (
+                    EXISTS (SELECT 1 FROM build_attributes a WHERE a.build_id=s.build_id
+                            AND a.attr=s.attr AND a.status IN ('pending','building'))
+                    OR (p.destination=$1 AND EXISTS (
+                      SELECT 1 FROM nixbot_uploads.publication_members other JOIN nixbot_uploads.publication_paths queued USING(destination,path)
+                      WHERE other.publication_id=s.id AND queued.state IN ('queued','uploading','retrying')))
+                  )) LIMIT 256""",
+                self.destination,
+                self.active_destinations,
+            )
+            for row in rows:
+                self._pin_name(row["path"], row["destination"]).unlink(missing_ok=True)
+            if rows:
+                await self.pool.executemany(
+                    "UPDATE nixbot_uploads.publication_paths SET pinned=false WHERE destination=$1 AND path=$2",
+                    [(row["destination"], row["path"]) for row in rows],
+                )
+
+    async def upload(self, paths, *, owner=None):
+        if not paths:
+            return UploadResult(True, "")
+        publication = await self._enqueue(paths, owner)
+        try:
+            while True:
+                ticket = await self.pool.fetchrow(
+                    "SELECT state,error FROM nixbot_uploads.publications WHERE id=$1",
+                    publication,
+                )
+                if ticket["state"] == "failed":
+                    return UploadResult(False, ticket["error"])
+                rows = await self.pool.fetch(
+                    """SELECT p.state,p.error FROM nixbot_uploads.publication_members m
+                    JOIN nixbot_uploads.publication_paths p USING(destination,path) WHERE m.publication_id=$1""",
+                    publication,
+                )
+                if any(r["state"] == "failed" for r in rows) or all(
+                    r["state"] == "complete" for r in rows
+                ):
+                    failed = [r["error"] for r in rows if r["state"] == "failed"]
+                    if failed:
+                        await self.pool.execute(
+                            "UPDATE nixbot_uploads.publications SET state='failed',error=$2 WHERE id=$1 AND state='waiting'",
+                            publication,
+                            "\n".join(failed),
+                        )
+                    else:
+                        await self.pool.execute(
+                            "UPDATE nixbot_uploads.publications SET state='complete' WHERE id=$1 AND state='waiting'",
+                            publication,
+                        )
+                    ticket = await self.pool.fetchrow(
+                        "SELECT state,error FROM nixbot_uploads.publications WHERE id=$1",
+                        publication,
+                    )
+                    return UploadResult(ticket["state"] == "complete", ticket["error"])
+                await asyncio.sleep(0.3)
+        except asyncio.CancelledError:
+            await self.pool.execute(
+                "UPDATE nixbot_uploads.publications SET state='cancelled' WHERE id=$1",
+                publication,
+            )
+            raise
+
+    async def _progress(self, path, file):
+        offset = 0
+        while True:
+            await asyncio.sleep(0.25)
+            with file.open() as stream:
+                stream.seek(offset)
+                lines = stream.readlines()
+                offset = stream.tell()
+            for line in lines:
+                with contextlib.suppress(ValueError, KeyError):
+                    data = json.loads(line)
+                    self.progress[path] = int(data["sent"])
+            if lines:
+                await self.pool.execute(
+                    """SELECT pg_notify('build_events',json_build_object('build_id',b.id,'project_id',b.project_id)::text)
+                    FROM nixbot_uploads.publications s JOIN builds b ON b.id=s.build_id
+                    JOIN nixbot_uploads.publication_members m ON m.publication_id=s.id
+                    WHERE m.destination=$1 AND m.path=$2 AND s.state='waiting'""",
+                    self.destination,
+                    path,
+                )
+
+    async def _transfer(self, path):
+        file = self._pin_name(path).with_suffix(".progress")
+        file.write_text("")
+        progress = asyncio.create_task(self._progress(path, file))
+        try:
+            command, env = self._command()
+            env["ATTIC_PROGRESS_FILE"] = str(file)
+            stdin = (path + "\n").encode() if self.config.paths_via == "stdin" else None
+            rc, out = await _run(
+                command if stdin else [*command, path],
+                stdin=stdin,
+                env=env,
+                timeout=self.timeout,
+            )
+            await self._finish(path, rc == 0, "" if rc == 0 else out[-4000:])
+        except asyncio.CancelledError:
+            await self.pool.execute(
+                "UPDATE nixbot_uploads.publication_paths SET state='queued' WHERE destination=$1 AND path=$2",
+                self.destination,
+                path,
+            )
+            raise
+        except Exception as exc:
+            await self._finish(path, False, str(exc))
+        finally:
+            self.progress.pop(path, None)
+            progress.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await progress
+            file.unlink(missing_ok=True)
+            self._wake.set()
+
+    async def _finish(self, path, success, output):
+        await self.pool.execute(
+            """WITH settled AS (
+            UPDATE nixbot_uploads.publication_paths SET state=CASE
+                WHEN $3 THEN 'complete' WHEN attempts >= $4 THEN 'failed' ELSE 'retrying' END,
+                error=$5,updated_at=now(),
+                available_at=now()+$6::double precision*interval '1 second'
+                WHERE destination=$1 AND path=$2 RETURNING destination,path,state,error
+            ) UPDATE nixbot_uploads.publications s SET state='failed',error=settled.error
+            FROM nixbot_uploads.publication_members m,settled WHERE s.id=m.publication_id
+                AND m.destination=settled.destination AND m.path=settled.path
+                AND settled.state='failed' AND s.state='waiting'""",
+            self.destination,
+            path,
+            success,
+            self.config.max_attempts,
+            output,
+            float(self.config.retry_delay),
+        )
+
+    async def _early(self):
+        while True:
+            buffered = self._take_buffer()
+            if buffered:
+                valid = await self.resolve(set(buffered))
+                if valid:
+                    try:
+                        await self._enqueue(sorted(valid), recursive=False)
+                    except Exception:
+                        logging.getLogger(__name__).exception(
+                            "early publication failed"
+                        )
+            await asyncio.sleep(0.25)
+
+    async def run(self):
+        while True:
+            try:
+                await self._exclusive()
+            except asyncio.CancelledError:
+                raise
+            except Exception:
+                logging.getLogger(__name__).exception("publication worker interrupted")
+                await asyncio.sleep(1)
+
+    async def _exclusive(self):
+        async with self.pool.acquire() as owner:
+            while not await owner.fetchval(
+                "SELECT pg_try_advisory_lock(hashtext('nixbot-publication'),hashtext($1))",
+                self.destination,
+            ):
+                await asyncio.sleep(1)
+            try:
+                await self._run_owned(owner)
+            finally:
+                await owner.execute(
+                    "SELECT pg_advisory_unlock(hashtext('nixbot-publication'),hashtext($1))",
+                    self.destination,
+                )
+
+    async def _run_owned(self, owner):
+        await self.pool.execute(
+            "UPDATE nixbot_uploads.publication_paths SET state='queued' WHERE destination=$1 AND state='uploading'",
+            self.destination,
+        )
+        early = asyncio.create_task(self._early())
+        active = set()
+        try:
+            while True:
+                if owner.is_closed():
+                    raise ConnectionError("publication ownership connection closed")
+                for task in list(active):
+                    if task.done():
+                        active.remove(task)
+                        task.result()
+                if early.done():
+                    early.result()
+                await self.pool.execute(
+                    """UPDATE nixbot_uploads.publications s SET state=CASE WHEN a.status='cancelled'
+                    THEN 'cancelled' ELSE 'failed' END,error='Attribute finalization ended'
+                    FROM build_attributes a WHERE s.destination=$1 AND s.state IN ('planning','waiting')
+                    AND a.build_id=s.build_id AND a.attr=s.attr AND a.status NOT IN ('pending','building')""",
+                    self.destination,
+                )
+                while len(active) < self.config.jobs:
+                    async with self._lock:
+                        row = await self.pool.fetchrow(
+                            """SELECT path FROM nixbot_uploads.publication_paths
+                            WHERE destination=$1 AND state IN ('queued','retrying') AND available_at<=now()
+                            ORDER BY available_at,path LIMIT 1""",
+                            self.destination,
+                        )
+                        if not row:
+                            break
+                        await self.pool.execute(
+                            "UPDATE nixbot_uploads.publication_paths SET state='uploading',attempts=attempts+1,updated_at=clock_timestamp() WHERE destination=$1 AND path=$2",
+                            self.destination,
+                            row["path"],
+                        )
+                    active.add(asyncio.create_task(self._transfer(row["path"])))
+                await self._cleanup_pins()
+                await asyncio.sleep(0.2)
+        finally:
+            early.cancel()
+            for task in active:
+                task.cancel()
+            await asyncio.gather(early, *active, return_exceptions=True)
