+++ b/nixbot/publication.sql
@@ -0,0 +1,46 @@
+CREATE SCHEMA nixbot_uploads;
+CREATE TABLE nixbot_uploads.publication_paths (
+    destination TEXT NOT NULL,
+    path TEXT NOT NULL,
+    state TEXT NOT NULL DEFAULT 'queued',
+    bytes BIGINT NOT NULL DEFAULT 0,
+    attempts INT NOT NULL DEFAULT 0,
+    error TEXT NOT NULL DEFAULT '',
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+    available_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+    pinned BOOLEAN NOT NULL DEFAULT false,
+    PRIMARY KEY (destination, path)
+);
+CREATE TABLE nixbot_uploads.publications (
+    id BIGSERIAL PRIMARY KEY,
+    build_id BIGINT NOT NULL REFERENCES builds(id) ON DELETE CASCADE,
+    attr TEXT NOT NULL,
+    destination TEXT NOT NULL,
+    state TEXT NOT NULL DEFAULT 'planning',
+    error TEXT NOT NULL DEFAULT '',
+    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+    UNIQUE (build_id, attr, destination)
+);
+CREATE TABLE nixbot_uploads.publication_members (
+    publication_id BIGINT NOT NULL REFERENCES nixbot_uploads.publications(id) ON DELETE CASCADE,
+    destination TEXT NOT NULL,
+    path TEXT NOT NULL,
+    PRIMARY KEY (publication_id, path),
+    FOREIGN KEY (destination, path) REFERENCES nixbot_uploads.publication_paths(destination, path)
+);
+CREATE FUNCTION nixbot_uploads.notify_publication_change() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE item RECORD;
+BEGIN
+  FOR item IN SELECT DISTINCT b.id,b.project_id FROM nixbot_uploads.publication_members m
+    JOIN nixbot_uploads.publications s ON s.id=m.publication_id JOIN builds b ON b.id=s.build_id
+    WHERE m.destination=NEW.destination AND m.path=NEW.path LOOP
+    PERFORM pg_notify('build_events',json_build_object('build_id',item.id,'project_id',item.project_id)::text);
+  END LOOP;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER publication_progress AFTER UPDATE ON nixbot_uploads.publication_paths
+  FOR EACH ROW EXECUTE FUNCTION nixbot_uploads.notify_publication_change();
+CREATE INDEX publications_waiting_idx ON nixbot_uploads.publications(destination,state);
+CREATE INDEX publication_pins_idx ON nixbot_uploads.publication_paths(destination) WHERE pinned;
+CREATE INDEX publication_members_path_idx ON nixbot_uploads.publication_members(destination,path);
+CREATE INDEX publication_pending_idx ON nixbot_uploads.publication_paths(destination,available_at) WHERE state IN ('queued','retrying');
